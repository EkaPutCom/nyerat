<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="NyeratPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferensi</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Umum</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Tampilan</property>
            <child>
              <object class="AdwComboRow" id="colorScheme">
                <property name="title" translatable="yes">Tema warna</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Ikuti sistem</item>
                      <item translatable="yes">Terang</item>
                      <item translatable="yes">Gelap</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="focus">
                <property name="title" translatable="yes">Mode fokus</property>
                <property name="subtitle" translatable="yes">Redupkan semua paragraf kecuali yang sedang disunting</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="typewriter">
                <property name="title" translatable="yes">Mode typewriter</property>
                <property name="subtitle" translatable="yes">Jaga baris yang sedang diketik tetap di tengah</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Berkas</property>
            <child>
              <object class="AdwSwitchRow" id="home">
                <property name="title" translatable="yes">Beranda</property>
                <property name="subtitle" translatable="yes">Tampilkan saat tidak ada dokumen yang terbuka</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="autosave">
                <property name="title" translatable="yes">Simpan otomatis</property>
                <property name="subtitle" translatable="yes">Berlaku untuk dokumen yang sudah punya file</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Asisten</property>
        <property name="icon-name">user-available-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwComboRow" id="chatModel">
                <property name="title" translatable="yes">Model</property>
                <property name="model">
                  <object class="GtkStringList" id="chatModels"/>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chatThinking">
                <property name="title" translatable="yes">Mode berpikir</property>
                <property name="subtitle" translatable="yes">Lebih teliti, tetapi lebih lambat</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chatSave">
                <property name="title" translatable="yes">Simpan riwayat percakapan</property>
                <property name="subtitle" translatable="yes">Disimpan di folder kerja, di .nyerat/chats</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
