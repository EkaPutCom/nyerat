{
  "name": "nyerat",
  "version": "1.0.0",
  "description": "Editor Markdown ala Typora dengan GTK 3 dan GJS",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Eka Putra <eka@ekaput.com>",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "node scripts/dev.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && gjs -m dist/nyerat.js",
    "test": "npm run build && gjs -m dist/run-tests.js",
    "docs": "npm run build && XDG_CONFIG_HOME=$(mktemp -d) gjs -m dist/capture.js"
  },
  "devDependencies": {
    "@girs/gdk-3.0": "^5.5.0",
    "@girs/gdkpixbuf-2.0": "^5.5.0",
    "@girs/gio-2.0": "^5.5.0",
    "@girs/gjs": "^5.5.0",
    "@girs/glib-2.0": "^5.5.0",
    "@girs/gobject-2.0": "^5.5.0",
    "@girs/gtk-3.0": "^5.5.0",
    "@girs/gtksource-4": "^5.5.0",
    "@girs/pango-1.0": "^5.5.0",
    "@girs/webkit2-4.1": "^5.5.0",
    "gifenc": "^1.0.3",
    "mermaid": "^12.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
